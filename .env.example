# Required for Google Sheets Data Fetching
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Required for IBKR trade log fetching (optional for dashboard-only)
IBKR_FLEX_TOKEN=your_ibkr_flex_token_here

# Required for the tape pressure dashboard (scripts/launch_tape_pressure.bat).
# Copy both from your browser: devtools -> Application -> Cookies ->
# https://www.tradingview.com. Together they are a FULL ACCOUNT SESSION TOKEN,
# not a scoped data key: anyone holding them can act as your account, and they
# are revoked only by logging out of TradingView. Never commit them, never put
# them in a CI secret, never paste them into a chat or a log.
# Without them BOTH boards stay empty. Relative volume is the only admission
# path on either tab, and the baselines behind it come from a TradingView
# websocket that the session cookie authenticates. No cookie, no baselines, no
# rows -- this is not a degraded board, it is an empty one.
TRADINGVIEW_SESSIONID=your_tradingview_sessionid_here
TRADINGVIEW_SESSION_SIGN=your_tradingview_sessionid_sign_here
